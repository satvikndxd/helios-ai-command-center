# =============================================================================
# Helios Gateway — environment configuration
# =============================================================================
# Copy to .env and edit as needed. The gateway runs with ZERO config using the
# built-in mock provider, so none of the API keys below are required to start.

# --- Database ----------------------------------------------------------------
HELIOS_DATABASE_URL=postgresql+psycopg2://helios:helios@localhost:5432/helios

# --- Default provider/model --------------------------------------------------
# Options: mock | openai | groq | openrouter | gemini | anthropic
HELIOS_DEFAULT_PROVIDER=mock
HELIOS_DEFAULT_MODEL=mock-model-1

# =============================================================================
# FREE LLM PROVIDERS (no paid account needed)
# =============================================================================
# Each of these has a genuinely free tier. Get a key, paste it below, then set
# HELIOS_DEFAULT_PROVIDER to the matching name (or pass "provider" per-request).

# --- Groq (free tier, very fast, OpenAI-compatible) --------------------------
# Get a key: https://console.groq.com/keys
HELIOS_GROQ_API_KEY=
HELIOS_DEFAULT_GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenRouter (free models, OpenAI-compatible) -----------------------------
# Get a key: https://openrouter.ai/keys  (pick any model ending in ":free")
HELIOS_OPENROUTER_API_KEY=
HELIOS_DEFAULT_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Google Gemini (free tier) -----------------------------------------------
# Get a key: https://aistudio.google.com/apikey
HELIOS_GEMINI_API_KEY=
HELIOS_DEFAULT_GEMINI_MODEL=gemini-1.5-flash

# =============================================================================
# KNOWLEDGE RETRIEVAL (Phase 2)
# =============================================================================
# Embedding provider: mock (default, zero-config) | gemini (free) | openai
HELIOS_EMBEDDING_PROVIDER=mock
# Vector dimension. 1536 = OpenAI text-embedding-3-small (and the mock).
# Gemini text-embedding-004 outputs 768 — set 768 BEFORE first ingestion.
HELIOS_EMBEDDING_DIM=1536
# Retrieval/chunking tuning
HELIOS_RETRIEVAL_TOP_K=3
HELIOS_CHUNK_SIZE=500
HELIOS_CHUNK_OVERLAP=50

# =============================================================================
# PAID PROVIDERS (optional — env-var ready, never required)
# =============================================================================
HELIOS_OPENAI_API_KEY=
HELIOS_DEFAULT_OPENAI_MODEL=gpt-4o-mini

HELIOS_ANTHROPIC_API_KEY=
HELIOS_DEFAULT_ANTHROPIC_MODEL=claude-3-5-sonnet-latest
